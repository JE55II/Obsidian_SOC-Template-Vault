views:
  - type: table
    name: View
    filters:
      and:
        - file.inFolder("🏢 Clients")
    order:
      - file.name
      - date
      - type
      - month
      - client
      - provider
      - tags
    sort:
      - property: date
        direction: DESC
      - property: client
        direction: DESC
      - property: file.mtime
        direction: DESC
